# 正式環境 nginx 範本:複製為 default.conf 後,把 example.com 與憑證路徑換成實際值。
# 憑證可用 certbot / 公司內部 CA 取得;HSTS 只在確定全站都走 HTTPS 後再啟用。

server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;
    root /var/www/html/public;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 應用層 (SecurityHeaders 中介層) 已送出 Referrer-Policy / Permissions-Policy / nosniff / HSTS / CSP,
    # 這裡只補框架嵌入限制與 HSTS(雙重保險)。
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # CSP 由應用層 SecurityHeaders 中介層送出(每次請求產生 nonce,不使用 unsafe-inline),這裡不要再重複設定,
    # 否則兩份 CSP 會同時生效,以較嚴格者為準而造成頁面異常。

    client_max_body_size 20m;
    index index.php;
    charset utf-8;
    server_tokens off;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 只有 /index.php 會交給 PHP 執行;其他任何 .php(例如被塞進上傳目錄的檔案)一律 404,
    # 即使程式漏掉某處的上傳檢查,也不會變成遠端程式執行 (RCE)。
    location = /index.php {
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ {
        return 404;
    }

    # 公開磁碟(/storage/*)的檔案一律沙箱化、禁止猜型別,避免上傳的 HTML/SVG 在本站網域執行
    location ^~ /storage/ {
        add_header Content-Security-Policy "sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        try_files $uri =404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
