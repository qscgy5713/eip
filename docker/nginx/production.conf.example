# 正式環境 nginx 範本:複製為 default.conf 後,把 example.com 與憑證路徑換成實際值。
# 憑證可用 certbot / 公司內部 CA 取得;HSTS 只在確定全站都走 HTTPS 後再啟用。

server {
    listen 80;
    listen [::]:80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;
    root /var/www/html/public;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 應用層 (SecurityHeaders 中介層) 已送出 Referrer-Policy / Permissions-Policy / nosniff / HSTS,
    # 這裡補上它管不到的部分:框架嵌入限制與 CSP。
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # CSP:前端有一小段內嵌腳本(防深色模式閃爍),因此 script-src 暫時允許 'unsafe-inline';
    # 若要更嚴格,需改用 nonce 並調整 resources/views/app.blade.php。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 20m;
    index index.php;
    charset utf-8;
    server_tokens off;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
