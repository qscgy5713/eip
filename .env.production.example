# 正式環境 .env 範本(複製為 .env 後修改;不要提交真實密碼)
APP_NAME="EIP 企業入口網"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Taipei
# 以 php artisan key:generate 產生
APP_KEY=

LOG_LEVEL=warning

# 資料庫 / 快取 / 佇列(寄信靠 queue worker,務必持續運行)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=eip_db
DB_USERNAME=eip_user
DB_PASSWORD=請改成強密碼
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
# HTTPS 下的 Session Cookie 只允許加密連線
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# 寄信(例:Gmail 應用程式密碼,或公司 SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# EIP 功能開關
EIP_MAIL_NOTIFICATIONS=true
# 建議管理員與人資強制啟用雙因素驗證
EIP_REQUIRE_2FA_ROLES=admin,hr
